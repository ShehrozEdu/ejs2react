{
  // Build config: source only (no tests), emits .d.ts into dist/.
  // This is the strict browser-safe check: `process`, `Buffer` and `node:*`
  // imports are type errors here, because nothing loads Node's types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    // Keep tsc's incremental state inside dist/, so cleaning dist/ (tsup does)
    // also resets it. Otherwise tsc thinks the deleted .d.ts files still exist.
    // Not a dotfile on purpose: tsup's clean skips dotfiles.
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
