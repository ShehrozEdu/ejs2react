{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The CLI runs in Node, so it gets Node's type definitions.
    "types": ["node"]
  },
  "include": ["src"],
  // The CLI depends on core: build core's types first.
  "references": [{ "path": "../core" }]
}
