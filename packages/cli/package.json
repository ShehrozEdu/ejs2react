{
  "name": "ejs2react",
  "version": "0.0.0",
  "description": "Migrate Express + EJS apps to React, and prove the converted pages render the same.",
  "license": "MIT",
  "author": "Shehroz Batt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShehrozEdu/ejs2react.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ejs",
    "react",
    "migration",
    "express",
    "codemod",
    "jsx"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "ejs2react": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "@ejs2react/core": "0.0.0",
    "@types/node": "^22.20.5"
  },
  "dependencies": {
    "commander": "^15.1.0"
  }
}
