{
  // Build config: source only (no tests), emits .d.ts into dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "exclude": ["src/**/*.test.ts"],
  // The CLI depends on core: build core's types first.
  "references": [{ "path": "../core/tsconfig.build.json" }]
}
