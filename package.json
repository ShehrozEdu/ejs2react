{
  "name": "ejs2react-monorepo",
  "private": true,
  "description": "Migrate Express + EJS apps to React, and prove the converted pages render the same.",
  "license": "MIT",
  "author": "Shehroz Batt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShehrozEdu/ejs2react.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p packages/core && tsc -p packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
