{
  "name": "ejs2react-monorepo",
  "private": true,
  "description": "Migrate Express + EJS apps to React, and prove the converted pages render the same.",
  "license": "MIT",
  "author": "Shehroz Batt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShehrozEdu/ejs2react.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p packages/core && tsc -p packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
